---
const { class: className } = Astro.props
---

<timered-counter-number class={className} id="timered-counter">
	<span slot="suffix">ms</span>
</timered-counter-number>

<script>
	import 'timered-counter';
	import type { TimeredCounterNumber } from 'timered-counter';

	const counter = document.getElementById('timered-counter') as TimeredCounterNumber;

	counter.animationOptions = ({ preprocessData }) => {
		let count = 0;
		return preprocessData.map((part) => part.map(() => ({delay: count++ * 100,})));
	};

	const observer = new PerformanceObserver((list) => {
		list.getEntries().forEach((entry) => {
			counter?.setAttribute('value', entry.startTime.toString());

		});
	});
	observer.observe({ entryTypes: ["largest-contentful-paint"], buffered: true });


	// counter?.setAttribute('value', str);
	// setInterval(() => {
	// 	str = str === '' ? 'Timered Counter' : '';
	// 	counter?.setAttribute('value', str);
	// }, 3000);
</script>	